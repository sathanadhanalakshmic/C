#include<stdio.h>
int main()
{
   int a[20],size,i,j,t,k;
   printf("Enter the size of the array:");
   scanf("%d",&size);
   printf("Enter the array elements:");
   for(i=0;i<size;i++)
   {
      scanf("%d",&a[i]);
   }
   for(i=0;i<size;i++)
   {
      for(j=i+1;j<size;j++)
      {
         if(a[i]>a[j])
         {
            t=a[i];
            a[i]=a[j];
            a[j]=t;
         }
      }
   }
   printf("Ascending order:");
   for(k=0;k<size;k++)
   {
      printf("%d\n",a[k]);
   }
   return 0;
}
