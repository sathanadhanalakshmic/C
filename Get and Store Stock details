#include<stdio.h>
#include<stdlib.h>
struct sto_det
{
   int item_id;
   char name[50];
   int avail;
   int price;
}*p;
int main()
{
   int i,n,c,h;
   printf("Enter the number of items:");
   scanf("%d",&n);
   p=(struct sto_det *)malloc(n*sizeof(struct sto_det));
   for(i=0;i<n;i++)
   {
      printf("Enter the item id:");
      scanf("%d",&p[i].item_id);
      printf("Enter the item name:");
      scanf("%s",&p[i].name);
      printf("Enter the stock quantity:");
      scanf("%d",&p[i].avail);
      printf("Enter the price:");
      scanf("%d",&p[i].price);
   }
   for(i=0;i<n;i++)
   {
      printf("%d\t%s\t%d\t%d\n",p[i].item_id,p[i].name,p[i].avail,p[i].price);
   }
   free(p);
}
