#include<stdio.h>
int main()
{
   int r,c,a[20][20],b[20][20],sum[20][20],sub[20][20],i,j;
   printf("Enter the number of rows");
   scanf("%d",&r);
   printf("Enter the number of columns:");
   scanf("%d",&c);
   printf("Enter the elements for 1st matrix:");
   for(i=0;i<r;i++)
   {
      for(j=0;j<c;j++)
      {
         scanf("%d",&a[i][j]);
      }
   }
   printf("Enter the elements for 2nd matrix:");
   for(i=0;i<r;i++)
   {
     for(j=0;j<c;j++)
     {
         scanf("%d",&b[i][j]);
     }
   }
   for(i=0;i<r;i++)
   {
      for(j=0;j<c;j++)
      {
         sum[i][j]=a[i][j]+b[i][j];
      }
   }
   printf("Addition of two matrixes\n");
   for(i=0;i<r;i++)
   {
      for(j=0;j<c;j++)
      {
         printf("%d\t",sum[i][j]);
      }
      printf("\n");
   }
   for(i=0;i<r;i++)
   {
      for(j=0;j<c;j++)
      {
         sub[i][j]=a[i][j]-b[i][j];
      }
   }
   printf("Subtraction of two matrixes\n");
   for(i=0;i<r;i++)
   {
       for(j=0;j<c;j++)
       {
          printf("%d\t",sub[i][j]);
       }
       printf("\n");
    }
}
