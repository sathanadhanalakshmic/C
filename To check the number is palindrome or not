#include<stdio.h>
int main()
{
   int num,count=0,rem,num1;
   printf("Enter a number:");
   scanf("%d",&num);
   num1=num;
   for( ;num!=0;)
   {
      rem=num%10;
      count=(count*10)+rem;
      num=num/10;
   }
   if(count==num1)
      printf("The given number is a palindrome");
   else
      printf("The given number is not a palindrome");
   return 0;
}
