#include<stdio.h>
int main()
{
   int a[20],b[20];
   int n,i,j=0;
   printf("Enter the size of the array:");
   scanf("%d",&n);
   printf("Enter the elements:");
   for(i=0;i<n;i++)
   {
      scanf("%d",&a[i]);
   }
   for(i=n-1;i>=0;i--)
   {
      b[j]=a[i];
      j++;
   }
   printf("The reversed array:");
   for(j=0;j<n;j++)
   {
      printf("%d\t",b[j]);
   }
